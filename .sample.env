# WhatsApp App Configuration

# Your App Id created from the Developer Account at developers.facebook.com
APP_ID= 

# Your App secret can be found in App Dashboard -> Settings -> Basic
APP_SECRET= 

# Your App Token is responsible to authorise and execute your calls from the App to Meta
# It can be genereted from the following URL:
# https://graph.facebook.com/oauth/access_token?client_id={{Your-App-Id}}&client_secret={{Your-App-Secret}}&grant_type=client_credentials
APP_TOKEN= 

# A random string you choose and is used for the webhook verification process
VERIFY_TOKEN= 

WHATSAPP_PHONE_NUMBER_ID= 

# URL where you host this code
# You can use a tunneling service like ngrok or Heroku
# It must be https, and without trailing slash.
APP_URL = 

# Preferred port
PORT = 